{
  "name": "celine-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:assistant": "pnpm --filter @celine-eu/assistant dev",
    "dev:webapp": "pnpm --filter @celine-eu/webapp dev",
    "dev:roi": "pnpm --filter @celine-eu/roi dev",
    "dev:grid": "pnpm --filter @celine-eu/grid dev",
    "dev:community": "pnpm --filter @celine-eu/community dev",
    "build": "pnpm -r build",
    "build:webapp": "pnpm --filter @celine-eu/webapp build",
    "build:assistant": "pnpm --filter @celine-eu/assistant build",
    "build:roi": "pnpm --filter @celine-eu/roi build",
    "build:grid": "pnpm --filter @celine-eu/grid build",
    "build:community": "pnpm --filter @celine-eu/community build",
    "check": "pnpm -r check",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "release-it": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
